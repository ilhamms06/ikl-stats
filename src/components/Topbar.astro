---
interface Props {
  navLinks?: { href: string; label: string }[];
}
const { navLinks = [] } = Astro.props;
---

<header class="topbar">
  <div class="wrap">
    <a class="mark" href="/">
      <svg viewBox="0 0 40 46" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M20 1l5 6 5-3-1 8 8 3-6 5 4 7-8 1-2 8-5-5-5 5-2-8-8-1 4-7-6-5 8-3-1-8 5 3z" fill="none" stroke="#E0A83C" stroke-width="1.3"/>
        <circle cx="20" cy="21" r="5.5" fill="none" stroke="#B02233" stroke-width="1.6"/>
        <circle cx="20" cy="21" r="1.8" fill="#E0A83C"/>
        <path d="M12 38h16l-3 6H15z" fill="#7A1220" stroke="#E0A83C" stroke-width="1"/>
      </svg>
      <span class="mark-txt"><span class="a">INDONESIA</span><span class="b">KINGS LAGA</span></span>
    </a>
    {navLinks.length > 0 && (
      <nav class="nav" id="nav">
        {navLinks.map(link => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
    )}
    <span class="season">2026 FALL</span>
  </div>
</header>
