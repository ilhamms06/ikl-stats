---
import Base from '../../layouts/Base.astro';
import MedalSvg from '../../components/MedalSvg.astro';
import DuelLane from '../../components/DuelLane.astro';
import ObjectiveRow from '../../components/ObjectiveRow.astro';
import GoldChart from '../../components/GoldChart.astro';
import { supabase } from '../../lib/supabase';

export async function getStaticPaths() {
  const { data: matches } = await supabase
    .from('matches')
    .select('code');
  return (matches || []).map(m => ({
    params: { code: m.code.toLowerCase() }
  }));
}

const { code } = Astro.params;
const upperCode = code!.toUpperCase();

const { data: match } = await supabase
  .from('matches')
  .select('*, team_a:teams!team_a_id(id, code, name, color), team_b:teams!team_b_id(id, code, name, color)')
  .eq('code', upperCode)
  .single();

const { data: games } = await supabase
  .from('games')
  .select('*, winner:teams!winner_team_id(code, name)')
  .eq('match_id', match?.id)
  .order('game_number');

const { data: gameTeams } = await supabase
  .from('game_teams')
  .select('*')
  .in('game_id', (games || []).map(g => g.id));

const { data: gamePlayers } = await supabase
  .from('v_game_player_stats')
  .select('*')
  .eq('match_id', match?.id)
  .order('game_number')
  .order('role');

const teamA = match?.team_a;
const teamB = match?.team_b;

const aWins = (games || []).filter(g => g.winner?.code === teamA?.code).length;
const bWins = (games || []).filter(g => g.winner?.code === teamB?.code).length;
const aWon = aWins >= bWins;

const formatDuration = (sec: number) => {
  const m = Math.floor(sec / 60);
  const s = sec % 60;
  return `${m}:${s.toString().padStart(2, '0')}`;
};

const nf = (v: number) => Math.round(v).toLocaleString('id-ID');
const kdaRatio = (k: number, d: number, a: number) => ((k + a) / Math.max(d, 1)).toFixed(2);

const ROLE_LABELS: Record<string, string> = {
  clash_lane: 'Clash Lane', jungle: 'Jungle', mid_lane: 'Mid Lane',
  farm_lane: 'Farm Lane', roam: 'Roam'
};

const navLinks = [
  { href: '#duel', label: 'DUEL LANE' },
  { href: '#scoreboard', label: 'SCOREBOARD' },
  { href: '#objektif', label: 'OBJEKTIF' },
  { href: '#gold', label: 'GOLD' },
  { href: '#mvp', label: 'MVP' },
];

const currentGame = games?.[0];
const currentGameId = currentGame?.id;
const currentDuration = currentGame ? formatDuration(currentGame.duration_seconds) : '—';

const playersA = (gamePlayers || []).filter(p => p.game_id === currentGameId && p.team_code === teamA?.code);
const playersB = (gamePlayers || []).filter(p => p.game_id === currentGameId && p.team_code === teamB?.code);

const gtA = (gameTeams || []).find(gt => gt.game_id === currentGameId && gt.team_id === teamA?.id);
const gtB = (gameTeams || []).find(gt => gt.game_id === currentGameId && gt.team_id === teamB?.id);

const goldA = gtA?.total_gold || 0;
const goldB = gtB?.total_gold || 0;

const objectives = [
  { label: 'TYRANT', a: gtA?.tyrant || 0, b: gtB?.tyrant || 0, cap: 3 },
  { label: 'SHADOW TYRANT', a: gtA?.shadow_tyrant || 0, b: gtB?.shadow_tyrant || 0, cap: 3 },
  { label: 'TEMPEST DRAGON', a: gtA?.tempest_dragon || 0, b: gtB?.tempest_dragon || 0, cap: 3 },
  { label: 'OVERLORD', a: gtA?.overlord || 0, b: gtB?.overlord || 0, cap: 3 },
  { label: 'SHADOW OVERLORD', a: gtA?.shadow_overlord || 0, b: gtB?.shadow_overlord || 0, cap: 3 },
  { label: 'TOWER', a: gtA?.towers || 0, b: gtB?.towers || 0, cap: 9 },
];

const mvpPlayer = (gamePlayers || []).find(p => p.game_id === currentGameId && p.is_mvp);

const totalKillsA = playersA.reduce((s, p) => s + p.kills, 0);
const totalDeathsA = playersA.reduce((s, p) => s + p.deaths, 0);
const totalAssistsA = playersA.reduce((s, p) => s + p.assists, 0);
const totalKillsB = playersB.reduce((s, p) => s + p.kills, 0);
const totalDeathsB = playersB.reduce((s, p) => s + p.deaths, 0);
const totalAssistsB = playersB.reduce((s, p) => s + p.assists, 0);
---

<Base
  title={`${teamA?.name} vs ${teamB?.name} — Match ${match?.code?.replace('M','')} · Indonesia Kings Laga`}
  navLinks={navLinks}
  source={`Sumber: siaran langsung · Match ${match?.code?.replace('M','')}, 2026 Fall Season`}
>

<div class="wrap">
  <p class="crumb"><a href="/">PERTANDINGAN</a> &nbsp;/&nbsp; MATCH {match?.code?.replace('M','')} — {teamA?.name?.toUpperCase()} VS {teamB?.name?.toUpperCase()}</p>
</div>

<!-- SCOREBOARD HERO -->
<div class="board">
  <div class="wrap">
    <div class="eyebrow">REGULAR SEASON · BEST OF 5 · MATCH {match?.code?.replace('M','')}</div>
    <div class="board-grid">
      <div class={`verdict ${aWon ? 'win' : 'lose'}`}>{aWon ? 'VICTORY' : 'DEFEAT'}<span class="sq">{teamA?.name?.toUpperCase()}</span></div>
      <div class="score-core">
        <span class="sc-tag">{teamA?.code}</span>
        <span class="sc-num tab-num">{aWins}</span>
        <MedalSvg class="medal" />
        <span class="sc-num tab-num">{bWins}</span>
        <span class="sc-tag">{teamB?.code}</span>
      </div>
      <div class={`verdict ${!aWon ? 'win' : 'lose'}`}>{!aWon ? 'VICTORY' : 'DEFEAT'}<span class="sq">{teamB?.name?.toUpperCase()}</span></div>
    </div>
    <div class="board-time">
      <div class="k">GAME TIME</div>
      <div class="v tab-num">{currentDuration}</div>
    </div>
  </div>
</div>

<div class="wrap">
  <div class="games">
    {(games || []).map((g, i) => (
      <button class={`gbtn${i === 0 ? ' on' : ''}`} disabled={i > 0}>
        GAME {g.game_number}
        <small>{formatDuration(g.duration_seconds)} · {g.winner?.code} MENANG</small>
      </button>
    ))}
    {Array.from({ length: Math.max(0, 5 - (games?.length || 0)) }, (_, i) => (
      <button class="gbtn" disabled>
        GAME {(games?.length || 0) + i + 1}
        <small>BELUM DIINPUT</small>
      </button>
    ))}
  </div>
</div>

<main class="wrap">

  <!-- DUEL -->
  <section id="duel" class="first">
    <div class="sec-head">
      <span class="idx">01 — HEAD TO HEAD</span>
      <h2>DUEL PER LANE</h2>
      <p>Membandingkan pemain yang berhadapan langsung di lane yang sama.</p>
    </div>
    <DuelLane teamA={teamA} teamB={teamB} playersA={playersA} playersB={playersB} />
  </section>

  <!-- SCOREBOARD -->
  <section id="scoreboard">
    <div class="sec-head">
      <span class="idx">02 — ANGKA MENTAH</span>
      <h2>SCOREBOARD LENGKAP</h2>
    </div>

    <div class="sb-title" style={`background:linear-gradient(90deg, ${teamA?.color}48, transparent)`}>
      <span class="d" style={`background:${teamA?.color}`}></span>
      {teamA?.name?.toUpperCase()} — {totalKillsA} / {totalDeathsA} / {totalAssistsA} · {(goldA / 1000).toFixed(1)}K GOLD
    </div>
    <div class="sb-wrap">
      <table>
        <thead>
          <tr><th>Pemain</th><th>Lane</th><th>K / D / A</th><th>KDA</th><th>Dmg Dealt</th><th>Dmg Taken</th><th>Gold</th><th>Teamfight</th></tr>
        </thead>
        <tbody>
          {playersA.map(p => (
            <tr>
              <td class="p-name">{p.player_handle}{p.is_mvp ? ' <span class="tag j">MVP</span>' : ''}</td>
              <td class="p-role">{ROLE_LABELS[p.role] || p.role}</td>
              <td class="kda-cell">{p.kills} / {p.deaths} / {p.assists}</td>
              <td class="tab-num">{kdaRatio(p.kills, p.deaths, p.assists)}</td>
              <td class="tab-num">{nf(p.damage_dealt)}</td>
              <td class="tab-num">{nf(p.damage_taken)}</td>
              <td class="tab-num">{nf(p.gold)}</td>
              <td class={`tab-num${p.teamfight_rate === 0 ? ' z' : ''}`}>{p.teamfight_rate}%</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="sb-title" style={`background:linear-gradient(90deg, ${teamB?.color}4D, transparent)`}>
      <span class="d" style={`background:${teamB?.color}`}></span>
      {teamB?.name?.toUpperCase()} — {totalKillsB} / {totalDeathsB} / {totalAssistsB} · {(goldB / 1000).toFixed(1)}K GOLD
    </div>
    <div class="sb-wrap">
      <table>
        <thead>
          <tr><th>Pemain</th><th>Lane</th><th>K / D / A</th><th>KDA</th><th>Dmg Dealt</th><th>Dmg Taken</th><th>Gold</th><th>Teamfight</th></tr>
        </thead>
        <tbody>
          {playersB.map(p => (
            <tr>
              <td class="p-name">{p.player_handle}</td>
              <td class="p-role">{ROLE_LABELS[p.role] || p.role}</td>
              <td class="kda-cell">{p.kills} / {p.deaths} / {p.assists}</td>
              <td class="tab-num">{kdaRatio(p.kills, p.deaths, p.assists)}</td>
              <td class="tab-num">{nf(p.damage_dealt)}</td>
              <td class="tab-num">{nf(p.damage_taken)}</td>
              <td class="tab-num">{nf(p.gold)}</td>
              <td class={`tab-num${p.teamfight_rate === 0 ? ' z' : ''}`}>{p.teamfight_rate}%</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- OBJEKTIF -->
  <section id="objektif">
    <div class="sec-head">
      <span class="idx">03 — KONTROL MAP</span>
      <h2>PEREBUTAN OBJEKTIF</h2>
      <p>Setiap balok mewakili satu objektif yang berhasil diambil.</p>
    </div>
    <ObjectiveRow objectives={objectives} teamAColor={teamA?.color || '#E0A83C'} teamBColor={teamB?.color || '#B02233'} />
  </section>

  <!-- GOLD -->
  <section id="gold">
    <div class="sec-head">
      <span class="idx">04 — EKONOMI</span>
      <h2>SELISIH GOLD</h2>
      <p>Area yang naik ke atas berarti {teamA?.name} sedang unggul gold.</p>
    </div>
    <GoldChart goldA={goldA} goldB={goldB} teamAName={teamA?.name || ''} teamBName={teamB?.name || ''} duration={currentDuration} />
  </section>

  <!-- MVP -->
  {mvpPlayer && (
    <section id="mvp">
      <div class="sec-head">
        <span class="idx">05 — PEMAIN TERBAIK</span>
        <h2>MVP GAME {currentGame?.game_number}</h2>
      </div>
      <div class="mvp-card">
        <div class="mvp-word"><span>INDOHONOR</span>MVP</div>
        <div>
          <div class="mvp-who">{mvpPlayer.player_handle}{mvpPlayer.hero_name ? ` — ${mvpPlayer.hero_name.toUpperCase()}` : ''}</div>
          <div class="mvp-sub">{mvpPlayer.team_name?.toUpperCase()} · {ROLE_LABELS[mvpPlayer.role] || mvpPlayer.role}</div>
          <div class="mvp-stats">
            <div><span class="k">KDA</span><span class="v tab-num">{mvpPlayer.kills} / {mvpPlayer.deaths} / {mvpPlayer.assists}</span></div>
            <div><span class="k">DAMAGE</span><span class="v tab-num">{nf(mvpPlayer.damage_dealt)}</span></div>
            <div><span class="k">DMG TAKEN</span><span class="v tab-num">{nf(mvpPlayer.damage_taken)}</span></div>
            <div><span class="k">TOTAL GOLD</span><span class="v tab-num">{nf(mvpPlayer.gold)}</span></div>
          </div>
        </div>
      </div>
    </section>
  )}

</main>

<script>
const links = [...document.querySelectorAll('#nav a')];
const spy = new IntersectionObserver(entries => {
  entries.forEach(en => {
    if(en.isIntersecting){
      links.forEach(l => l.classList.toggle('on', l.getAttribute('href') === '#' + en.target.id));
    }
  });
}, { rootMargin:'-25% 0px -65% 0px' });
document.querySelectorAll('main section').forEach(s => spy.observe(s));
</script>

</Base>
