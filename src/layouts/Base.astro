---
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  navLinks?: { href: string; label: string }[];
  source?: string;
}

const { title, navLinks = [], source } = Astro.props;
---

<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow+Semi+Condensed:wght@400;500;600;700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles/ikl.css">
</head>
<body>
  <div class="layer">
    <Topbar navLinks={navLinks} />
    <slot />
    <Footer source={source} />
  </div>
</body>
</html>
